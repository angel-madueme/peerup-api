  "version": "1.0.0",
  "description": "Peerup peer study group and tutoring matcher API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "lint": "eslint src eslint.config.js",
