  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.5",
    "@types/node": "^26.6.2",
    "eslint": "^9.37.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "@types/supertest": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "nanoid": "^6.0.1",
    "prisma": "^6.19.3",
    "zod": "^4.1.12"
